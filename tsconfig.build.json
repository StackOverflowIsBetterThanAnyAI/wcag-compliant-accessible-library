{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "rootDir": "src",
        "outDir": "dist",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true
    },
    "include": ["src"],
    "exclude": [
        "src/**/*.stories.tsx",
        "src/**/*.test.tsx",
        "src/**/*.test-d.tsx",
        "src/test"
    ]
}
